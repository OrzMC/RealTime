# Normalise line endings so a Windows checkout and a Linux CI checkout agree.
# Without this, `core.autocrlf` on Windows makes whole files look modified and
# the diff becomes noise (or worse, a CRLF commit lands in the history).
* text=auto eol=lf

# Windows-only launchers keep CRLF; git still stores them with LF.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary assets: never normalise, never diff.
*.jar binary
*.zip binary
*.gz binary
*.tar binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
